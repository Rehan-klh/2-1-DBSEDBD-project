# PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/hostel_db

# MongoDB Atlas connection URI (for notifications, mess_feedback, and activity_logs)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=hostel_mess_db

# JWT Configuration (Required: Set to a strong, random secret key in production)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Frontend API URL
VITE_API_URL=http://localhost:8000/api
